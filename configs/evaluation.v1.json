      "parameters": [70000000, 410000000, 1400000000, 2800000000, 6900000000],
      "test": "exact_120_permutation_spearman",
      "alternative": "rho_less_than_zero",
      "x": "log10_parameters"
    },
    "ceiling": {
      "detection": "unrounded_test_auroc_exactly_one",
      "enumerate_globally_consistent_relative_orders": true,
      "tulu_break_ceiling_ties_consistently_in_every_source_block": true,
